<Window x:Class="ChessUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessUI"
        mc:Ignorable="d"
        Title="MainWindow" 
        Width="947" 
        Height="760"
        SizeToContent="Height"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#101010"
        KeyDown="Window_KeyDown">

    <Grid Margin="10">

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>
            <!-- Captured -->
            <ColumnDefinition Width="140"/>
            <!-- Board -->
            <ColumnDefinition Width="560"/>
            <!-- History -->
            <ColumnDefinition Width="220"/>

        </Grid.ColumnDefinitions>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <!-- Timer -->
            <RowDefinition Height="70"/>
            <!-- Main -->
            <RowDefinition Height="540"/>
            <!-- Buttons -->
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- TIMER -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock x:Name="WhiteTimerText"
                       Text="White: 10:00"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="20"/>

            <TextBlock x:Name="BlackTimerText"
                       Text="Black: 10:00"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="20"/>
        </StackPanel>

        <!-- CAPTURED -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Width="120"
                Height="520"
                Background="#202020"
                CornerRadius="10"
                Margin="10">

            <StackPanel Margin="10">
                <TextBlock Text="Captured"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- White -->
                <TextBlock Text="White"
                           Foreground="White"
                           FontSize="16"
                           Margin="0,0,0,10"/>

                <WrapPanel x:Name="WhiteCapturedPanel"
                           Margin="0,0,0,30"/>

                <!-- Black -->
                <TextBlock Text="Black"
                           Foreground="White"
                           FontSize="16"
                           Margin="0,0,0,10"/>

                <WrapPanel x:Name="BlackCapturedPanel"/>
            </StackPanel>
        </Border>

        <!-- BOARD -->
        <Viewbox Grid.Row="1"
                 Grid.Column="1">

            <Grid x:Name="BoardGrid"
                  Width="520"
                  Height="520"
                  MouseDown="BoardGrid_MouseDown">

                <Grid.Background>
                    <ImageBrush ImageSource="/Assets/Board.png"/>
                </Grid.Background>

                <UniformGrid x:Name="HighlightGrid"
                             Rows="8"
                             Columns="8"/>

                <UniformGrid x:Name="PiecesGrid"
                             Rows="8"
                             Columns="8"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                <ContentControl x:Name="MenuContainer"/>
            </Grid>
        </Viewbox>

        <!-- RIGHT PANEL -->
        <StackPanel Grid.Row="1"
                    Grid.Column="2"
                    Margin="10">

            <!-- STATUS -->
            <Border Width="200"
                    Height="60"
                    Background="#202020"
                    CornerRadius="10"
                    Margin="0,0,0,10">

                <TextBlock x:Name="StatusText"
                            Text="White to move"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextAlignment="Center"/>
            </Border>

            <!-- MOVE HISTORY -->
            <Border Width="200"
                    Height="450"
                    Background="#202020"
                    CornerRadius="10">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <TextBlock x:Name="MoveHistoryText"
                                Foreground="White"
                                FontSize="18"
                                Padding="10"
                                TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="Undo"
                    Width="100"
                    Height="40"
                    Margin="10"
                    Click="Undo_Click"/>

            <Button Content="Redo"
                    Width="100"
                    Height="40"
                    Margin="10"
                    Click="Redo_Click"/>
        </StackPanel>
    </Grid>
</Window>